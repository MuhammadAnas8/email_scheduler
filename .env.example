# Copy this file to .env.local for local development.
# Do not use real credentials until the corresponding integration phase.

# Server-only Supabase values (configured in Phase 2; never prefix with NEXT_PUBLIC_)
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_ANON_KEY=local-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key-placeholder

# Google OAuth (configured in Phase 5)
GOOGLE_CLIENT_ID=replace-with-your-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# 32-byte key encoded as 64 hexadecimal characters (configured in Phase 5)
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
